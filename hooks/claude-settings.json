{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"$HOME/.forge/hooks/forge_hook.py\" session-start" } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "python3 \"$HOME/.forge/hooks/forge_hook.py\" pre-compact" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit",
        "hooks": [ { "type": "command", "command": "python3 \"$HOME/.forge/hooks/forge_hook.py\" post-tool" } ] }
    ]
  }
}
